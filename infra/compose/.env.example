# Local identity stack for AegisMCP (FEAT-009, NFR-029, operations.md "Enterprise Identity
# Provider (SSO / OIDC) Federation").
#
# Copy this file to `.env` only when you want to choose the credentials yourself; otherwise let
# the bootstrap script create them:
#
#   node infra/compose/bootstrap-oidc.mjs init
#   docker compose -f infra/compose/compose.yaml up -d
#   node infra/compose/bootstrap-oidc.mjs provision
#   docker compose -f infra/compose/compose.yaml --profile smoke run --rm oidc-smoke
#
# `.env` is ignored by infra/compose/.gitignore. No credential is committed, and the compose file
# refuses to start when one is missing.

# --- Provider ----------------------------------------------------------------

# Browser-facing base URL of the provider. The realm name "aegis" is fixed by the realm export and
# by the issuer below.
AEGIS_OIDC_PUBLIC_URL=http://localhost:8081

# Host port published for the provider.
AEGIS_OIDC_PUBLIC_PORT=8081

# The issuer the provider stamps into every token; must equal <AEGIS_OIDC_PUBLIC_URL>/realms/aegis.
AEGIS_OIDC_ISSUER=http://localhost:8081/realms/aegis

# Bootstrap administrator user name; its password is generated by init and stays in .env.
KEYCLOAK_ADMIN_USERNAME=admin

# Password of the provider's bootstrap administrator. Leave empty; init generates one.
KEYCLOAK_ADMIN_PASSWORD=

# Provider log level (debug, info, warn, error).
KEYCLOAK_LOG_LEVEL=warn

# --- Console ----------------------------------------------------------------

# Public PKCE client registered for the console. Fixed by the realm export.
AEGIS_OIDC_CONSOLE_CLIENT_ID=aegis-console

# Redirect URI registered on that client; must equal the console origin plus "/".
AEGIS_OIDC_CONSOLE_REDIRECT_URI=http://localhost:3000/

# Audience the gateway requires on access tokens; issued by the console client's audience mapper.
AEGIS_OIDC_AUDIENCE=aegis-gateway

# --- Console user passwords --------------------------------------------------

# Passwords for aegis-admin, aegis-operator, aegis-auditor, and aegis-viewer. Leave empty; init
# generates one per account and provision applies them to the imported realm users.
AEGIS_OIDC_ADMIN_USER_PASSWORD=
AEGIS_OIDC_OPERATOR_USER_PASSWORD=
AEGIS_OIDC_AUDITOR_USER_PASSWORD=
AEGIS_OIDC_VIEWER_USER_PASSWORD=

# --- Gateway ----------------------------------------------------------------

# Host port published for the gateway.
AEGIS_GATEWAY_PORT=8443

# --- Console environment (apps/console/.env) ---------------------------------
#
# The console reads these four settings from its own environment. They are the provider values
# above, restated in the console's variable names:
#
#   VITE_OIDC_AUTHORITY=http://localhost:8081/realms/aegis
#   VITE_OIDC_CLIENT_ID=aegis-console
#   VITE_OIDC_REDIRECT_URI=http://localhost:3000/
#   VITE_OIDC_SCOPE=openid profile email roles
#   VITE_GATEWAY_PROXY_TARGET=http://localhost:8443
#
# The console discovers the signing keys from the issuer's discovery document; the gateway reads
# them directly from the provider. Both resolve to the same public endpoints:
#
#   Issuer       http://localhost:8081/realms/aegis
#   JWKS URL     http://localhost:8081/realms/aegis/protocol/openid-connect/certs
#   Audience     aegis-gateway
#   Console ID   aegis-console
#
# The realm defines one user per role (aegis-admin, aegis-operator, aegis-auditor, aegis-viewer).
# Each must enrol a one-time-password factor on first sign-in; the provider generates the seed, so
# no second-factor secret exists anywhere in the repository.
