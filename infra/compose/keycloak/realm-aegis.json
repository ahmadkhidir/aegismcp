{
  "realm": "aegis",
  "enabled": true,
  "displayName": "AegisMCP",
  "displayNameHtml": "<strong>AegisMCP</strong> Identity",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": [
    "totpAppFreeOTPName",
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName"
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "SAMEORIGIN",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains",
    "referrerPolicy": "no-referrer"
  },
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full control of policies, approvals, kill switch, audit, and compliance."
      },
      {
        "name": "operator",
        "description": "Runs live traffic, resolves approvals, and trips the emergency kill switch."
      },
      {
        "name": "auditor",
        "description": "Reads policy, approval history, audit records, and compliance exports."
      },
      {
        "name": "viewer",
        "description": "Reads fleet status, metrics, and live traffic without mutating anything."
      }
    ]
  },
  "clients": [
    {
      "clientId": "aegis-console",
      "name": "AegisMCP Web Console",
      "description": "Public single-page console client using Authorization Code Flow with PKCE (SHA-256).",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "protocolMappers": [
        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "aegis-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "aegis-gateway",
      "name": "AegisMCP Gateway",
      "description": "Audience for agent and console access tokens validated by the gateway. Bearer-only: it issues no tokens and holds no credential.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "consentRequired": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false"
      }
    }
  ],
  "users": [
    {
      "id": "6f1f8b2a-0d7f-4a0f-9a0e-91f4d0c2a101",
      "username": "aegis-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Avery",
      "lastName": "Admin",
      "email": "aegis-admin@aegis.local",
      "realmRoles": [
        "admin"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "id": "6f1f8b2a-0d7f-4a0f-9a0e-91f4d0c2a102",
      "username": "aegis-operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ola",
      "lastName": "Operator",
      "email": "aegis-operator@aegis.local",
      "realmRoles": [
        "operator"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "id": "6f1f8b2a-0d7f-4a0f-9a0e-91f4d0c2a103",
      "username": "aegis-auditor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Auditor",
      "email": "aegis-auditor@aegis.local",
      "realmRoles": [
        "auditor"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "id": "6f1f8b2a-0d7f-4a0f-9a0e-91f4d0c2a104",
      "username": "aegis-viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Vera",
      "lastName": "Viewer",
      "email": "aegis-viewer@aegis.local",
      "realmRoles": [
        "viewer"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    }
  ]
}
