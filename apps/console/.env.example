# Local development gateway proxy. Leave unset when the console is served from
# the gateway origin. The Vite dev server proxies /api to this origin.
VITE_GATEWAY_PROXY_TARGET=

# OIDC provider issuer URL, without a trailing slash.
# Example: https://identity.example.com/realms/aegis
VITE_OIDC_AUTHORITY=

# Public PKCE client registered for this console.
VITE_OIDC_CLIENT_ID=

# Must be registered as a redirect URI on the client above.
VITE_OIDC_REDIRECT_URI=http://localhost:3000/

# Roles are read from the ID token's `roles`, `realm_access.roles`, or
# `resource_access.<client id>.roles` claim.
VITE_OIDC_SCOPE=openid profile email roles
