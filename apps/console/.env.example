# Console environment for local development. Copy to `.env.local` and keep it
# untracked (`.gitignore` ignores `.env*` except this example). This file holds
# no secret: the console is a public PKCE client and every value is a public
# endpoint, client identifier, or scope.
#
# Provider and gateway values match the local stack in infra/compose. Bring it
# up first: node infra/compose/bootstrap-oidc.mjs init
#              docker compose -f infra/compose/compose.yaml up -d
#              node infra/compose/bootstrap-oidc.mjs provision
# The four role accounts are aegis-admin, aegis-operator, aegis-auditor, and
# aegis-viewer; each enrols a one-time-password factor on first sign-in.

# --- Gateway -----------------------------------------------------------------

# Gateway API base the console calls. Leave at the default when developing
# through the Vite proxy; set an absolute URL (for example
# https://aegis.internal.example/api/v1) when the console is served from a
# different origin than the gateway.
VITE_API_BASE_URL=/api/v1

# Origin the Vite dev server proxies `/api` to. The local gateway listens on
# 8443 with TLS disabled inside the compose stack (AEGIS_TLS_ENABLED=false).
# Leave empty to use this default.
VITE_GATEWAY_PROXY_TARGET=http://localhost:8443

# --- Local Keycloak identity provider ----------------------------------------

# Issuer of the local realm, without a trailing slash. It must equal
# <AEGIS_OIDC_PUBLIC_URL>/realms/aegis from infra/compose/.env.
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/aegis

# Public authorization-code + PKCE client registered by the realm export.
VITE_OIDC_CLIENT_ID=aegis-console

# Registered redirect URI for that client. It must match the dev-server origin
# and the realm's valid redirect URI exactly.
VITE_OIDC_REDIRECT_URI=http://localhost:3000/

# Claims requested for RBAC. Roles are read from the ID token's `roles`,
# `realm_access.roles`, or `resource_access.<client id>.roles` claim.
VITE_OIDC_SCOPE=openid profile email roles
