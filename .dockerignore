# Docker reads this file only from the build context root, which is the repository root.
# Keep the context to the inputs the image stages declare (infra/AGENTS.md).

# Version control and coordination metadata
.git
.gitmodules
.github
.decisions
docs
contracts
assets

# Local environment, secrets, and host state. `.env`/`.env.*` match at the context root only, so
# the nested files (for example the compose stack's generated credentials) are excluded by their
# own patterns; no environment file or key material enters the build context (NFR-023, NFR-028).
.env
.env.*
**/.env
**/.env.*
**/*.jks
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/*.crt
**/*.p8
**/secrets/
local.properties
*.log
*.hprof

# Build outputs and dependency caches
.gradle/
**/.gradle/
**/build/
**/dist/
**/node_modules/
# Docker matches a bare `*.tsbuildinfo` only at the context root; `**/` covers the nested
# TypeScript build info that app builds emit (NFR-020).
**/*.tsbuildinfo

# Editor and OS files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
